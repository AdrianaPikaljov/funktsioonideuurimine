@{
    var tegevus = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var lemmikud = ViewBag.Lemmikud is true;
    bool Akt(params string[] nimed) => nimed.Contains(tegevus, StringComparer.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('teema'); } catch (e) { }
            if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <title>@(ViewData["Title"] ?? "Funktsioonide uurija")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-md app-nav mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Funktsioonid" asp-action="Create">📈 Funktsioonide uurija</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Menüü">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto gap-1 mt-2 mt-md-0">
                    <li class="nav-item">
                        <a class="nav-link @(Akt("Create") ? "active" : "")" asp-controller="Funktsioonid" asp-action="Create">✏️ Uus uurimine</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Akt("Index", "Details", "Edit") && !lemmikud ? "active" : "")" asp-controller="Funktsioonid" asp-action="Index">💾 Salvestatud</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Akt("Index") && lemmikud ? "active" : "")" asp-controller="Funktsioonid" asp-action="Index" asp-route-lemmik="true">⭐ Lemmikud</a>
                    </li>
                </ul>
                <div class="d-flex gap-2 mt-2 mt-md-0">
                    <button type="button" id="teemaNupp" class="btn btn-outline-secondary btn-sm" title="Vaheta teemat" aria-label="Vaheta teemat">
                        <span class="teema-must">● Must</span><span class="teema-valge">○ Valge</span>
                    </button>
                    <a class="btn btn-akt btn-sm" asp-controller="Funktsioonid" asp-action="Create">+ Lisa funktsioon</a>
                </div>
            </div>
        </div>
    </nav>
    <div class="container pb-5">@RenderBody()</div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('teemaNupp').addEventListener('click', function () {
            var d = document.documentElement;
            var uus = d.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
            d.setAttribute('data-bs-theme', uus);
            try { localStorage.setItem('teema', uus); } catch (e) { }
            document.dispatchEvent(new CustomEvent('teema-muutus', { detail: uus }));
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
