@using FunktsiooniUurija.Services
@model FunktsiooniUurimine
@{
    ViewData["Title"] = "f(x) = " + Model.Valem;
    var valitud = Valikud.Parsi(Model.Valik);
    // (võti, silt, väärtus, kood?)
    var read = new List<(string silt, string vaartus, bool kood)>();
    void Lisa(string voti, string silt, string vaartus, bool kood = false)
    {
        if (valitud.Contains(voti) && !string.IsNullOrEmpty(vaartus)) read.Add((silt, vaartus, kood));
    }
    Lisa("maar", "Määramispiirkond", Model.Maaramispiirkond);
    Lisa("tuletis", "Tuletis f'(x)", Model.Tuletis, true);
    Lisa("krit", "Kriitilised punktid", Model.KriitilisedPunktid);
    Lisa("kasv", "Kasvab", Model.Kasvamine);
    Lisa("kasv", "Kahaneb", Model.Kahanemine);
    Lisa("ekst", "Ekstreemumid", Model.Ekstreemumid);
    Lisa("kaan", "Käänupunktid", Model.Kaanupunkt);
    Lisa("yloige", "Lõige y-teljega", Model.LoigeYTeljega);
    Lisa("null", "Nullkohad", Model.Nullkohad);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0 font-monospace" style="word-break:break-all">f(x) = @Model.Valem</h2>
    <div class="d-flex gap-2 align-items-center">
        <form asp-action="Lemmik" asp-route-id="@Model.Id" asp-route-tagasi="@Url.Action("Details", new { id = Model.Id })" method="post">
            <button class="btn btn-outline-secondary btn-sm" title="@(Model.Lemmik ? "Eemalda lemmikutest" : "Lisa lemmikutesse")">@(Model.Lemmik ? "★ Lemmik" : "☆ Lisa lemmikuks")</button>
        </form>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@Model.Id">Muuda</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="kaart">
            <div class="kaart-sisu">
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-4"><label class="form-label small mb-1" for="xMin">x min</label><input id="xMin" type="number" class="form-control form-control-sm" value="-5" step="any" /></div>
                    <div class="col-4"><label class="form-label small mb-1" for="xMax">x max</label><input id="xMax" type="number" class="form-control form-control-sm" value="5" step="any" /></div>
                    <div class="col-4"><label class="form-label small mb-1" for="samm">Samm</label><input id="samm" type="number" class="form-control form-control-sm" value="0.1" step="any" min="0.001" /></div>
                </div>
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <button type="button" class="btn btn-akt btn-sm" onclick="joonesta()">Joonista</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="suumi(1.25)" title="Suurenda">＋</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="suumi(0.8)" title="Vähenda">−</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="joonesta()">Lähtesta</button>
                    <span class="text-muted small ms-1">Hiireratas / näpuliigutus – suum, lohistamine – liigutamine</span>
                </div>
                <div class="graafik-kast"><canvas id="funktsiooniGraafik"></canvas></div>
                <p id="graafikuTeade" class="text-muted small mb-0 mt-2"></p>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="kaart">
            <div class="kaart-pea">Tulemused</div>
            <div class="kaart-sisu tulemused py-2">
                @if (read.Count == 0)
                {
                    <p class="text-muted my-3">Valitud arvutuste tulemused on lahenduskäigus.</p>
                }
                @foreach (var (silt, vaartus, kood) in read)
                {
                    <div class="rida">
                        <span class="silt">@silt</span>
                        @if (kood) { <span class="vaartus"><code>@vaartus</code></span> }
                        else { <span class="vaartus">@vaartus</span> }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (ViewBag.Lahendus is List<Samm> sammud)
{
    <div class="d-flex align-items-center gap-3 mt-4 mb-3">
        <h3 class="mb-0">📘 Lahenduskäik</h3>
        <button type="button" id="lahendusNupp" class="btn btn-outline-akt btn-sm" aria-expanded="false" aria-controls="lahenduseKast">Näita lahenduskäiku</button>
        <button type="button" id="voltimisNupp" class="btn btn-link btn-sm text-decoration-none" style="display:none">Voldi kõik kokku</button>
    </div>
    <p id="lahenduseVihje" class="text-muted small">Lahenduskäik on peidetud. Vajuta nuppu (või Ctrl + ˇ), et seda näha.</p>
    <div id="lahenduseKast" style="display:none">
        <div id="lahendus">
            @for (int i = 0; i < sammud.Count; i++)
            {
                var samm = sammud[i];
                <div class="samm-kaart">
                    <div class="samm-pea" title="Klõpsa, et kokku/lahti voltida">
                        <span class="nr">@(i + 1)</span>
                        <span class="fw-semibold">@samm.Pealkiri</span>
                        <span class="nool">▾</span>
                    </div>
                    <div class="samm-keha">
                        @if (samm.Pealkiri == "Kokkuvõte")
                        {
                            <table class="table table-sm table-striped mb-0 mt-2">
                                <tbody>
                                    @foreach (var rida in samm.Read)
                                    {
                                        var k = rida.IndexOf(": ");
                                        <tr><th style="width:30%">@(k > 0 ? rida.Substring(0, k) : "")</th><td>@(k > 0 ? rida.Substring(k + 2) : rida)</td></tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            @foreach (var rida in samm.Read)
                            {
                                if (rida.StartsWith("Tulemus: "))
                                {
                                    <div class="alert alert-success py-2 px-3 my-2 fw-semibold">✔ @rida.Substring(9)</div>
                                }
                                else if (rida.StartsWith("Selgitus: "))
                                {
                                    <div class="text-muted fst-italic my-2">💡 @rida.Substring(10)</div>
                                }
                                else
                                {
                                    <div class="font-monospace py-1 border-bottom">@rida</div>
                                }
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    <script>
        (function () {
          const kast = document.getElementById('lahenduseKast'), vihje = document.getElementById('lahenduseVihje'),
                nupp = document.getElementById('lahendusNupp'), volt = document.getElementById('voltimisNupp');
          function naita(jah) {                              // vaikimisi peidetud
            kast.style.display = jah ? '' : 'none';
            vihje.style.display = jah ? 'none' : '';
            volt.style.display = jah ? '' : 'none';
            nupp.textContent = jah ? 'Peida lahenduskäik' : 'Näita lahenduskäiku';
            nupp.setAttribute('aria-expanded', jah ? 'true' : 'false');
          }
          const nahtav = () => kast.style.display !== 'none';
          nupp.addEventListener('click', () => naita(!nahtav()));
          document.addEventListener('keydown', function (e) {
            if (e.repeat) return;                            // hoitud klahv ei tohi edasi-tagasi lülitada
            if (e.ctrlKey && (e.code === 'Backquote' || e.key === 'ˇ')) { e.preventDefault(); naita(!nahtav()); }
          });
          const kaardid = [...document.querySelectorAll('#lahendus .samm-kaart')];
          kaardid.forEach(k => k.querySelector('.samm-pea').addEventListener('click', () => k.classList.toggle('kokku')));
          let kokkuVoltud = false;
          volt.addEventListener('click', () => {
            kokkuVoltud = !kokkuVoltud;
            kaardid.forEach(k => k.classList.toggle('kokku', kokkuVoltud));
            volt.textContent = kokkuVoltud ? 'Ava kõik' : 'Voldi kõik kokku';
          });
          naita(false);
        })();
    </script>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1"></script>
    <script>
        let graafik, uuendusAeg;
        const graafikuId = @Model.Id;
        const valem = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Valem));

        function punktideks(d) { return d.x.map((x, i) => ({ x: x, y: d.y[i] })); }

        // Pärast suumi/liigutamist laadime nähtava piirkonna ümber uued punktid,
        // et joon oleks ka lähedalt sile ja ei lõppeks poole peal.
        function viiviUuendus(c) {
          clearTimeout(uuendusAeg);
          uuendusAeg = setTimeout(() => uuendaPunktid(c), 150);
        }
        async function uuendaPunktid(c) {
          const a = c.scales.x.min, b = c.scales.x.max, w = b - a;
          if (!(w > 0)) return;
          const lo = a - w, hi = b + w, st = Math.max(w / 300, 0.0005);
          const r = await fetch(`/Funktsioonid/Punktid/${graafikuId}?min=${lo.toFixed(6)}&max=${hi.toFixed(6)}&samm=${st.toFixed(6)}`);
          if (!r.ok || c !== graafik) return;
          c.data.datasets[0].data = punktideks(await r.json());
          c.update('none');
        }
        function suumi(k) { if (graafik) { graafik.zoom(k); viiviUuendus(graafik); } }

        async function joonesta() {
          const min = document.getElementById('xMin').value,
                max = document.getElementById('xMax').value,
                samm = document.getElementById('samm').value;
          const r = await fetch(`/Funktsioonid/Punktid/${graafikuId}?min=${min}&max=${max}&samm=${samm}`);
          if (!r.ok) { alert('Vigane vahemik'); return; }
          const d = await r.json();
          document.getElementById('graafikuTeade').textContent =
            d.y.includes(null) ? 'Funktsioon pole mõnes punktis määratud.' : 'Funktsioon on määratud iga x korral.';
          if (graafik) graafik.destroy();
          graafik = new Chart(document.getElementById('funktsiooniGraafik').getContext('2d'), {
            type: 'scatter',
            data: { datasets: [
              { label: 'f(x) = ' + valem, data: punktideks(d), borderColor: '#4f46e5', borderWidth: 2.5,
                pointRadius: 0, showLine: true, tension: 0.3, spanGaps: false }
            ]},
            options: {
              responsive: true, maintainAspectRatio: false, animation: false,
              plugins: {
                legend: { display: false },
                zoom: {
                  zoom: { wheel: { enabled: true }, pinch: { enabled: true }, mode: 'xy',
                          onZoomComplete: ({ chart }) => viiviUuendus(chart) },
                  pan:  { enabled: true, mode: 'xy', onPanComplete: ({ chart }) => viiviUuendus(chart) }
                }
              },
              scales: {
                x: { type: 'linear', min: Number(min), max: Number(max),
                     title: { display: true, text: 'x' },
                     grid: { color: c => c.tick.value === 0 ? '#000' : 'rgba(0,0,0,0.1)',
                             lineWidth: c => c.tick.value === 0 ? 1.5 : 1 } },
                y: { title: { display: true, text: 'y' },
                     grid: { color: c => c.tick.value === 0 ? '#000' : 'rgba(0,0,0,0.1)',
                             lineWidth: c => c.tick.value === 0 ? 1.5 : 1 } }
              }
            }
          });
        }
        joonesta();
    </script>
}
